def fit_standard_sigmas(image, center_x, center_y, sky_x, sky_y,
                        fit_half_window=15, sky_half_window=10):
    """Fit Gaussian widths for a standard star."""
    star_cutout = extract_square(
        image, center_x, center_y, fit_half_window
    )
    sky_cutout = extract_square(
        image, sky_x, sky_y, sky_half_window
    )
    sky_level = np.nanmedian(sky_cutout)

    data = star_cutout - sky_level
    yy, xx = np.indices(data.shape)

    guess = models.Gaussian2D(
        amplitude=np.nanmax(data),
        x_mean=fit_half_window,
        y_mean=fit_half_window,
        x_stddev=5.0,
        y_stddev=5.0,
    )

    fitted = fitting.LevMarLSQFitter()(
        guess, xx, yy, data, maxiter=1000
    )

    return float(fitted.x_stddev.value), float(fitted.y_stddev.value)


