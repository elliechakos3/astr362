def extract_square(data, center_x, center_y, half_window):
    """Return a square image cutout centered on (center_x, center_y)."""
    cx = int(round(center_x))
    cy = int(round(center_y))
    half_window = int(half_window)

    x0, x1 = cx - half_window, cx + half_window + 1
    y0, y1 = cy - half_window, cy + half_window + 1

    if x0 < 0 or y0 < 0 or x1 > data.shape[1] or y1 > data.shape[0]:
        raise ValueError(
            "The requested cutout extends beyond the image edge. "
            "Choose a different center or a smaller window."
        )

    return data[y0:y1, x0:x1]


def gaussian_psf_weights(center_x, center_y, sigma_x, sigma_y,
                         half_window):
    """Create normalized 2D Gaussian PSF weights in a square window."""
    if sigma_x <= 0 or sigma_y <= 0:
        raise ValueError("Gaussian widths sigma_x and sigma_y must be positive.")

    cx = int(round(center_x))
    cy = int(round(center_y))
    half_window = int(half_window)

    x = np.arange(cx - half_window, cx + half_window + 1)
    y = np.arange(cy - half_window, cy + half_window + 1)
    xx, yy = np.meshgrid(x, y)

    psf = np.exp(
        -0.5 * (
            ((xx - center_x) / sigma_x) ** 2
            + ((yy - center_y) / sigma_y) ** 2
        )
    )

    psf_sum = np.sum(psf)
    if psf_sum <= 0:
        raise ValueError("The Gaussian PSF has no positive weight.")

    return psf / psf_sum


def phot(data, center_x, center_y, sigma_x, sigma_y,
         sky_x, sky_y, half_window):
    """
    Estimate a star's flux using Gaussian PSF weights and a blank sky cutout.

    Returns the normalized PSF, weighted star cutout, net flux estimate,
    median sky level per pixel, and effective number of noise pixels.
    """
    star_cutout = extract_square(data, center_x, center_y, half_window)
    sky_cutout = extract_square(data, sky_x, sky_y, half_window)

    # Estimate sky from the median of the blank cutout.
    sky_per_pixel = float(np.median(sky_cutout))

    psf = gaussian_psf_weights(
        center_x, center_y, sigma_x, sigma_y, half_window
    )

    weighted_signal = psf * (star_cutout - sky_per_pixel)
    psf_squared_sum = np.sum(psf**2)

    if psf_squared_sum <= 0:
        raise ValueError("The squared PSF weights sum to zero.")

    net_flux = float(np.sum(weighted_signal) / psf_squared_sum)

    n_effective = float(1.0 / psf_squared_sum)

    return psf, weighted_signal, net_flux, sky_per_pixel, n_effective


def calculate_snr_and_magnitude(net_flux, sky_per_pixel, n_effective,
                                exposure_seconds, gain_e_per_adu,
                                read_noise_adu):
   
    if net_flux <= 0:
        raise ValueError(
            f"Net flux must be positive to calculate a magnitude; got {net_flux}."
        )
    if exposure_seconds <= 0:
        raise ValueError("Exposure time must be positive.")
    if gain_e_per_adu <= 0:
        raise ValueError("Gain must be positive.")

    source_electrons = net_flux * gain_e_per_adu
    sky_electrons_per_pixel = max(sky_per_pixel, 0.0) * gain_e_per_adu
    read_noise_electrons = read_noise_adu * gain_e_per_adu

    variance_electrons = (
        source_electrons
        + n_effective * sky_electrons_per_pixel
        + n_effective * read_noise_electrons**2
    )

    snr = source_electrons / np.sqrt(variance_electrons)
    instrumental_mag = -2.5 * np.log10(net_flux / exposure_seconds)

    magnitude_error = 1.0 / snr

    return instrumental_mag, magnitude_error, snr

