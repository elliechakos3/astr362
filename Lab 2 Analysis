def get_flat_region(filename, avg_bias):
    """
    Load a twilight flat, convert it to ADU,
    subtract the average bias, and return a
    small region of the image.
    """

    with fits.open(
        filename,
        memmap=True,
        do_not_scale_image_data=True
    ) as hdul:

        header = hdul[0].header
        raw = hdul[0].data[y0:y1, x0:x1].astype(np.float32)

        bscale = header.get("BSCALE", 1.0)
        bzero = header.get("BZERO", 0.0)

        flat_adu = (
            raw * bscale + bzero
        ) / 16.0 + 1.0

    bias_region = avg_bias[y0:y1, x0:x1].astype(np.float32)

    corrected_flat = flat_adu - bias_region

    return corrected_flat


def measure_flat_pair(flat_a_path, flat_b_path, avg_bias):
    """
    Measure the average signal and ADU variance
    from two approximately equally illuminated,
    bias-corrected twilight flats.
    """

    flat_a = get_flat_region(flat_a_path, avg_bias)
    flat_b = get_flat_region(flat_b_path, avg_bias)

    mean_a = np.mean(flat_a)
    mean_b = np.mean(flat_b)

    scale = mean_a / mean_b

    difference = flat_a - scale * flat_b

    difference_variance = np.var(difference, ddof=1)

    variance = difference_variance / (1 + scale**2)

    signal = (mean_a + scale * mean_b) / 2

    return signal, variance, scale


