def measure_snr_and_magnitude(net_flux, sky_per_pixel, n_pixels,
                              exposure, gain, read_noise):
    """Calculate aperture SNR and instrumental magnitude."""
    if net_flux <= 0:
        raise ValueError("Net flux must be positive to calculate a magnitude.")

    variance = (
        gain * net_flux
        + n_pixels * gain * sky_per_pixel
        + n_pixels * read_noise**2
    )
    snr = net_flux / np.sqrt(variance)
    instrumental_mag = -2.5 * np.log10(net_flux / exposure)
    magnitude_error = 1.0 / snr  # Approximation specified in the lab handout

    return instrumental_mag, magnitude_error, snr
